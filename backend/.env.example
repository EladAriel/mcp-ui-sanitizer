# Sanitizer settings use the SANITIZER_ prefix.
SANITIZER_LLM_PROVIDER=openai
SANITIZER_LLM_MODEL=gpt-5.6-luna
SANITIZER_LLM_TEMPERATURE=0
SANITIZER_LLM_MAX_TOKENS=16384
SANITIZER_MAX_CODE_BYTES=250000
SANITIZER_MAX_CONCURRENT_JOBS=4
SANITIZER_JOB_TTL_SECONDS=3600
SANITIZER_CORS_ORIGINS=["http://localhost:5173"]

# Provider credentials (not prefixed).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Langfuse is optional. Raw and sanitized source are traced when enabled.
SANITIZER_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
