# Sanitizer settings use the SANITIZER_ prefix.
SANITIZER_LLM_PROVIDER=openai
SANITIZER_LLM_MODEL=gpt-5.6-luna
SANITIZER_LLM_TEMPERATURE=0
SANITIZER_LLM_MAX_TOKENS=16384
SANITIZER_MAX_CODE_BYTES=250000
SANITIZER_MAX_CONCURRENT_JOBS=4
SANITIZER_JOB_TTL_SECONDS=3600
SANITIZER_CORS_ORIGINS=["http://localhost:5173"]
# Comma-separated absolute paths the workflow API may read.
# SANITIZER_WORKSPACE_ROOTS=/home/you/projects
# Example mocks: point at the repo's example/ folder (see example/README.md).
# SANITIZER_WORKSPACE_ROOTS=/home/you/eladDevelop/mcp-ui-sanitizer/example

# Provider credentials (not prefixed).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# OpenRouter (when SANITIZER_LLM_PROVIDER=openrouter).
# SANITIZER_LLM_MODEL=openai/gpt-4o-mini
# SANITIZER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SANITIZER_OPENROUTER_HTTP_REFERER=http://localhost:5173
# SANITIZER_OPENROUTER_APP_TITLE=UI Design Sanitizer

# Langfuse is optional. Source code stays redacted by default; opt in only after
# reviewing Langfuse retention and access controls.
SANITIZER_LANGFUSE_ENABLED=true
SANITIZER_LANGFUSE_CAPTURE_CODE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
